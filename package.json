{
  "name": "finance-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "server": "NODE_ENV=development node server/index.js",
    "client": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "lint": "eslint src server --ext .js,.jsx --max-warnings 0",
    "test": "node --test tests/**/*.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "check:routes": "node --test tests/routes.test.js",
    "prepare:ios": "npx cap add ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  }
}
